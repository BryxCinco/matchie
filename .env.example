# App (Vercel) and every worker
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: the owner's auth.users id (same value as MATCHIE_USER_ID).
# Shows "Connected" on the Settings email card for the owner.
MATCHIE_OWNER_ID=

# LLMs: Gemini first, Groq when Gemini fails
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Workers only (GitHub Actions). Never used in app/.
SUPABASE_SERVICE_ROLE_KEY=
# The owner: email-poller and digest act for this account only.
# ats-poller, score-matches and ghosting-checker serve every user.
MATCHIE_USER_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
# RESEND_FROM="Matchie <onboarding@resend.dev>"
# DIGEST_TO=
